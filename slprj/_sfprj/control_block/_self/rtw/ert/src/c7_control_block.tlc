    }\
    ChartData {\
      Name         "frecuencia_acc"\
      Description  "EmlPersistent"\
      SFName       ""\
      Path         ""\
      SrcLocation  "control_block:501:643-657"\
    }\
    ChartData {\
      Name         "antiguo_maximo"\
      Description  "EmlPersistent"\
